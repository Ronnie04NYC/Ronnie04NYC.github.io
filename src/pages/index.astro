---
import Base from '../layouts/Base.astro';
const regions = [
 {id:'frontal', n:'01', region:'Frontal lobe', title:'The Truth Index', label:'Judgment & inquiry', description:'A starting point for finding sources worth your attention.', anatomy:'Supports planning, reasoning, and decision-making.', url:'https://truthindex.xyz/', color:'#35e5ff', d:'M480 182 C377 184 308 239 263 312 C234 365 220 431 256 465 C283 486 318 492 356 482 L393 429 L481 371 L514 329 L503 265 Z', x:365,y:327},
 {id:'parietal', n:'02', region:'Parietal lobe', title:'The Great Wealth Transfer', label:'Patterns & perspective', description:'Explore the movement of wealth and the systems around it.', anatomy:'Integrates sensory information and supports spatial processing.', url:'https://wealth-transfer.vercel.app/',color:'#ae78ff',d:'M480 182 C541 164 614 179 666 211 L700 283 L641 339 L566 357 L481 371 L514 329 L503 265 Z',x:573,y:259},
 {id:'temporal', n:'03', region:'Temporal lobe', title:'Propaganda Exposure Index', label:'Language & interpretation', description:'Examine the messages competing to shape your perspective.', anatomy:'Contributes to hearing, memory, and language comprehension.',url:'https://propaganda-index.vercel.app/',color:'#ffba48',d:'M356 482 L393 429 L481 371 L566 357 L641 339 L701 355 L686 413 C622 451 557 479 512 518 C459 558 408 550 394 507 Z',x:511,y:445},
 {id:'occipital',n:'04',region:'Occipital lobe',title:'The WACC',label:'A shared vision',description:'From scattered pressure to coordinated action. Explore the WACC.',anatomy:'Primarily processes visual information.',url:'https://x.com/_DrMoonhatt4n_/status/2031886765301133312',color:'#ff6b78',d:'M666 211 C724 241 758 318 771 384 C784 421 745 449 686 438 L686 413 L701 355 L641 339 L700 283 Z',x:718,y:361},
];
---
<Base>
  <div class="intro-row"><div><p class="eyebrow"><span class="status-dot"></span> The Moonhatt4n laboratory</p><h1>A mind.<br/><em>Many rabbit holes.</em></h1></div><p class="intro">Art, evidence, and systems.<br/>Explore the connections.</p></div>
  <section class="lab" aria-label="Interactive project brain map">
    <div class="lab-bar"><span>SPECIMEN / 001</span><span>ANATOMICAL MODEL · 360°</span></div>
    <div class="lab-body">
      <div class="specimen">
        <div class="brain-stage" tabindex="0" role="group" aria-label="Interactive 3D brain. Drag to rotate; use arrow keys when focused. Select a brain region to inspect its project.">
          <img class="brain-fallback" src="/brain-sculpture.png" alt="Brain sculpture above a fixed pedestal" width="1254" height="1254"/>
        </div>
        <div class="brain-controls"><button id="reset-brain" type="button">Reset view</button><button id="spin-brain" type="button" aria-pressed="true">Auto-rotate: on</button></div>
        <p class="model-status" role="status">Loading 3D brain…</p>
      </div>
      <aside class="readout" aria-label="Selected project">
        {regions.map((r,i)=><div class:list={['project-detail',{active:i===0}]} data-detail={r.id}><p class="eyebrow">REGION {r.n} / {r.region}</p><p class="signal" style={`color:${r.color}`}>{r.label}</p><h2>{r.title}</h2><p>{r.description}</p><a class="open-project" href={r.url}>Explore project <span aria-hidden="true">↗</span></a><div class="anatomy"><span>ANATOMY NOTE</span><p>{r.anatomy}</p></div></div>)}
      </aside>
    </div>
    <nav class="project-list" aria-label="All brain map projects">{regions.map(r=><a href={r.url} data-region={r.id} style={`--region:${r.color}`}><span class="number">{r.n}</span><span>{r.title}<small>{r.region}</small></span><span aria-hidden="true">↗</span></a>)}</nav>
  </section>
  <div class="below"><p>Project associations are thematic; brain functions span networks.</p><a href="https://linktr.ee/Dr.Moonhatt4n">More from my world ↗</a></div>
  <p class="model-credit">3D anatomy: <a href="https://github.com/itayinbarr/brainproject">Brain Project</a>, Z-Anatomy / BodyParts3D © DBCLS · <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a> · <a href="/brain-license.txt">Full credits</a>. Presentation recolored; original model geometry unchanged.</p>
  <script>
    const targets = document.querySelectorAll<HTMLElement | SVGElement>('[data-region]');
    let selectedRegion: string | undefined;
    function select(id: string | undefined) {
      if(id===selectedRegion)return;
      selectedRegion=id;
      document.querySelectorAll('[data-detail]').forEach(el=>el.classList.toggle('active',el.getAttribute('data-detail')===id));
      targets.forEach(el=>el.classList.toggle('selected',el.dataset.region===id));
    }
    targets.forEach(el=>{
      el.addEventListener('pointerenter',event=>{if((event as PointerEvent).pointerType!=='touch') select(el.dataset.region);});
      el.addEventListener('focus',()=>select(el.dataset.region));
      el.addEventListener('click',event=>{
        if(el.classList.contains('brain-region') && (event as PointerEvent).pointerType==='touch') {event.preventDefault();select(el.dataset.region);}
      });
    });
    select('frontal');

    import * as THREE from 'three';
    import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
    import { DRACOLoader } from 'three/addons/loaders/DRACOLoader.js';
    import { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';

    const stage = document.querySelector<HTMLElement>('.brain-stage')!;
    const status = document.querySelector<HTMLElement>('.model-status')!;
    const spinButton = document.querySelector<HTMLButtonElement>('#spin-brain')!;
    const resetButton = document.querySelector<HTMLButtonElement>('#reset-brain')!;
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    async function initBrain() {
      const renderer = new THREE.WebGLRenderer({antialias:true,alpha:true});
      renderer.setPixelRatio(Math.min(devicePixelRatio,2));
      renderer.setClearColor(0x040b13,1);
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = .95;
      renderer.shadowMap.enabled=true;renderer.shadowMap.type=THREE.PCFSoftShadowMap;
      renderer.domElement.setAttribute('aria-hidden','true');
      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(37,1,.1,40);
      camera.position.set(0,1.3,6.9); camera.lookAt(0,.15,0);
      const environment = new RoomEnvironment();
      const pmrem = new THREE.PMREMGenerator(renderer);
      const envTexture = pmrem.fromScene(environment).texture;
      scene.environment = envTexture; scene.environmentIntensity=.22; environment.dispose(); pmrem.dispose();
      scene.add(new THREE.HemisphereLight(0xbce9ef,0x18212d,.4));
      const key = new THREE.DirectionalLight(0xcfefff,1.8); key.position.set(-3,5,4);key.castShadow=true;key.shadow.mapSize.set(1024,1024);key.shadow.camera.left=-3;key.shadow.camera.right=3;key.shadow.camera.top=3;key.shadow.camera.bottom=-3;key.shadow.normalBias=.025; scene.add(key);
      const cyan = new THREE.DirectionalLight(0x32dfff,3); cyan.position.set(-4,1,-2);scene.add(cyan);
      const coral = new THREE.DirectionalLight(0xff7845,3);coral.position.set(3,1,0);scene.add(coral);
      // Stationary pedestal and support belong directly to the scene, never to the rotating brain.
      const pedestal = new THREE.Mesh(new THREE.BoxGeometry(3.5,.28,2.8),new THREE.MeshStandardMaterial({color:0x111a23,metalness:.7,roughness:.38}));
      pedestal.receiveShadow=true;pedestal.position.y=-1.6;scene.add(pedestal);
      const trim = new THREE.LineSegments(new THREE.EdgesGeometry(pedestal.geometry),new THREE.LineBasicMaterial({color:0x70cbd8,transparent:true,opacity:.18}));
      trim.position.copy(pedestal.position);scene.add(trim);
      const support = new THREE.Mesh(new THREE.CylinderGeometry(.022,.022,1,12),new THREE.MeshStandardMaterial({color:0x718996,metalness:.85,roughness:.25}));
      support.position.y=-1.04;scene.add(support);
      const brain = new THREE.Group(); brain.position.y=.35;brain.rotation.y=-Math.PI/2;scene.add(brain);
      const draco = new DRACOLoader();draco.setDecoderPath('/');
      const loader = new GLTFLoader();loader.setDRACOLoader(draco);
      const gltf = await loader.loadAsync('/brain.glb');draco.dispose();
      const meshes: THREE.Mesh[] = [];
      const colors: Record<string,string> = {frontal:'#35e5ff',parietal:'#ae78ff',temporal:'#ffba48',occipital:'#ff6b78'};
      gltf.scene.traverse(object=>{
        if (!(object instanceof THREE.Mesh)) return;
        let anatomicalNode: THREE.Object3D | null = object;
        while (anatomicalNode && !anatomicalNode.userData.bx_cat) anatomicalNode=anatomicalNode.parent;
        const metadata=anatomicalNode?.userData || {};
        const cat = metadata.bx_cat;
        if (!['cortex','cerebellum','brainstem'].includes(cat)) {object.visible=false;return;}
        object.userData.projectRegion = String(metadata.bx_region || '').split(' ')[0].toLowerCase();
        object.material = new THREE.MeshPhysicalMaterial({color:cat==='cortex'?0xb9c9ca:0x14232b,metalness:cat==='cortex'?.35:.9,roughness:.23,clearcoat:.65,clearcoatRoughness:.3});
        object.castShadow=true;object.receiveShadow=true;
        meshes.push(object);
      });
      gltf.scene.updateMatrixWorld(true);
      const bounds = new THREE.Box3();meshes.forEach(mesh=>bounds.expandByObject(mesh));
      const size=bounds.getSize(new THREE.Vector3());const center=bounds.getCenter(new THREE.Vector3());
      // Surface-bound traces stay on their anatomical mesh as the brain turns.
      meshes.forEach(mesh=>{
        const material=mesh.material as THREE.MeshPhysicalMaterial;
        const activation={value:0};
        mesh.userData.circuitActivation=activation;
        mesh.userData.circuitTarget=0;
        material.onBeforeCompile=shader=>{
          shader.uniforms.circuitActivation=activation;
          shader.uniforms.circuitColor={value:new THREE.Color(colors[mesh.userData.projectRegion] || '#63cddd')};
          shader.uniforms.circuitScale={value:38/Math.max(size.x,size.y,size.z)};
          shader.vertexShader='varying vec3 circuitPosition; varying vec3 circuitNormal;\n'+shader.vertexShader;
          shader.vertexShader=shader.vertexShader.replace('#include <begin_vertex>','#include <begin_vertex>\ncircuitPosition=position; circuitNormal=normal;');
          shader.fragmentShader=`
            varying vec3 circuitPosition;
            varying vec3 circuitNormal;
            uniform float circuitActivation;
            uniform vec3 circuitColor;
            uniform float circuitScale;
            float tracePattern(vec2 p){
              vec2 cell=floor(p); vec2 q=fract(p);
              float h=fract(sin(dot(cell,vec2(127.1,311.7)))*43758.5453);
              if(h>.5) q=q.yx;
              float width=max(fwidth(p.x),fwidth(p.y))*.7+.018;
              float line=1.-smoothstep(.018,.018+width,abs(q.y-.5));
              line*=step(.18,q.x)*step(q.x,.82);
              float branch=1.-smoothstep(.018,.018+width,abs(q.x-.8));
              branch*=step(.5,q.y)*step(q.y,.99)*step(.45,h);
              float ring=1.-smoothstep(.012,.012+width,abs(length(q-vec2(.2,.5))-.065));
              return max(max(line,branch),ring);
            }
          `+shader.fragmentShader;
          shader.fragmentShader=shader.fragmentShader.replace('#include <emissivemap_fragment>',`#include <emissivemap_fragment>
            vec3 circuitWeights=pow(abs(normalize(circuitNormal)),vec3(8.));
            circuitWeights/=max(dot(circuitWeights,vec3(1.)),.001);
            vec3 cp=circuitPosition*circuitScale;
            float circuitry=dot(vec3(tracePattern(cp.yz),tracePattern(cp.xz),tracePattern(cp.xy)),circuitWeights);
            totalEmissiveRadiance+=circuitColor*circuitry*(.025+1.5*circuitActivation);
          `);
        };
        material.customProgramCacheKey=()=> 'brain-circuitry-v1';
      });
      gltf.scene.position.sub(center);
      const normalizer=new THREE.Group();normalizer.add(gltf.scene);normalizer.scale.setScalar(2.8/Math.max(size.x,size.y,size.z));brain.add(normalizer);
      stage.append(renderer.domElement);stage.classList.add('ready');
      status.textContent='Drag to rotate · Hover to illuminate a region';
      const raycaster=new THREE.Raycaster();const pointer=new THREE.Vector2();
      let hover=false, dragging=false, moved=false, enabled=!reducedMotion.matches;
      let lastX=0,lastY=0, startX=0,startY=0, lastTime=0, visible=true;
      const initialRotation=-Math.PI/2;
      function syncButton(){spinButton.setAttribute('aria-pressed',String(enabled));spinButton.textContent=enabled?'Auto-rotate: on':'Auto-rotate: off';}
      syncButton();
      function highlight(region:string|undefined){
        meshes.forEach(mesh=>{mesh.userData.circuitTarget=mesh.userData.projectRegion===region && colors[region || '']?1:0;});
      }
      function pickCurrent(){raycaster.setFromCamera(pointer,camera);const hit=raycaster.intersectObjects(meshes,false)[0];return hit?.object.userData.projectRegion as string|undefined;}
      function pick(event:PointerEvent){const rect=stage.getBoundingClientRect();pointer.set((event.clientX-rect.left)/rect.width*2-1,-(event.clientY-rect.top)/rect.height*2+1);return pickCurrent();}
      stage.addEventListener('pointerenter',event=>{hover=event.pointerType!=='touch';pick(event);});
      stage.addEventListener('pointerleave',()=>{hover=false;if(!dragging)highlight(undefined);});
      stage.addEventListener('pointerdown',event=>{if(event.button!==0)return;dragging=true;moved=false;startX=lastX=event.clientX;startY=lastY=event.clientY;stage.setPointerCapture(event.pointerId);});
      stage.addEventListener('pointermove',event=>{
        if(dragging){if(Math.hypot(event.clientX-startX,event.clientY-startY)>5)moved=true;brain.rotation.y+=(event.clientX-lastX)*.008;brain.rotation.x=THREE.MathUtils.clamp(brain.rotation.x+(event.clientY-lastY)*.006,-.8,.8);lastX=event.clientX;lastY=event.clientY;}
        else {const region=pick(event);if(colors[region || '']){select(region);highlight(region);stage.style.cursor='pointer';}else{highlight(undefined);stage.style.cursor='grab';}}
      });
      function release(event:PointerEvent){if(!dragging)return;dragging=false;if(stage.hasPointerCapture(event.pointerId))stage.releasePointerCapture(event.pointerId);if(!moved){const region=pick(event);if(colors[region || '']){select(region);highlight(region);}}}
      stage.addEventListener('pointerup',release);stage.addEventListener('pointercancel',()=>{dragging=false;hover=false;});
      stage.addEventListener('keydown',event=>{if(!['ArrowLeft','ArrowRight','ArrowUp','ArrowDown'].includes(event.key))return;event.preventDefault();if(event.key==='ArrowLeft')brain.rotation.y-=.15;if(event.key==='ArrowRight')brain.rotation.y+=.15;if(event.key==='ArrowUp')brain.rotation.x=Math.max(-.8,brain.rotation.x-.1);if(event.key==='ArrowDown')brain.rotation.x=Math.min(.8,brain.rotation.x+.1);});
      resetButton.addEventListener('click',()=>{brain.rotation.set(0,initialRotation,0);highlight(undefined);select('frontal');});
      spinButton.addEventListener('click',()=>{enabled=!enabled;syncButton();});
      reducedMotion.addEventListener('change',()=>{enabled=!reducedMotion.matches;syncButton();});
      targets.forEach(el=>{el.addEventListener('focus',()=>highlight(el.dataset.region));el.addEventListener('pointerenter',()=>highlight(el.dataset.region));el.addEventListener('pointerleave',()=>highlight(undefined));el.addEventListener('blur',()=>highlight(undefined));});
      const resize = new ResizeObserver(()=>{const w=stage.clientWidth,h=stage.clientHeight;if(!w||!h)return;renderer.setSize(w,h);camera.aspect=w/h;camera.updateProjectionMatrix();});resize.observe(stage);
      const observer = new IntersectionObserver(entries=>{visible=entries[0].isIntersecting;});observer.observe(stage);
      renderer.setAnimationLoop(time=>{const dt=Math.min((time-lastTime)/1000,.05);lastTime=time;if(!visible||document.hidden)return;if(!dragging&&enabled&&!reducedMotion.matches)brain.rotation.y+=dt*.09;if(hover&&!dragging){brain.updateMatrixWorld(true);const region=pickCurrent();highlight(region);if(colors[region || ''])select(region);}
        meshes.forEach(mesh=>{mesh.userData.circuitActivation.value=THREE.MathUtils.damp(mesh.userData.circuitActivation.value,mesh.userData.circuitTarget,9,dt);});renderer.render(scene,camera);});
      renderer.domElement.addEventListener('webglcontextlost',event=>{event.preventDefault();renderer.setAnimationLoop(null);stage.classList.remove('ready');renderer.domElement.hidden=true;status.textContent='3D view unavailable. Project links remain available below.';});
      window.addEventListener('pagehide',()=>{renderer.setAnimationLoop(null);resize.disconnect();observer.disconnect();renderer.dispose();envTexture.dispose();});
    }
    initBrain().catch(()=>{status.textContent='3D view unavailable. Use the project links below.';spinButton.disabled=true;resetButton.disabled=true;});
  </script>
</Base>
