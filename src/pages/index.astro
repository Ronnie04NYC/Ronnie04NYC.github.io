---
import Base from '../layouts/Base.astro';
const regions = [
 {id:'frontal', n:'01', region:'Frontal lobe', title:'The Truth Index', label:'Judgment & inquiry', description:'A starting point for finding sources worth your attention.', anatomy:'Supports planning, reasoning, and decision-making.', url:'https://truthindex.xyz/', color:'#99e8cb', d:'M480 182 C377 184 308 239 263 312 C234 365 220 431 256 465 C283 486 318 492 356 482 L393 429 L481 371 L514 329 L503 265 Z', x:365,y:327},
 {id:'parietal', n:'02', region:'Parietal lobe', title:'The Great Wealth Transfer', label:'Patterns & perspective', description:'Explore the movement of wealth and the systems around it.', anatomy:'Integrates sensory information and supports spatial processing.', url:'https://wealth-transfer.vercel.app/',color:'#b4b7f2',d:'M480 182 C541 164 614 179 666 211 L700 283 L641 339 L566 357 L481 371 L514 329 L503 265 Z',x:573,y:259},
 {id:'temporal', n:'03', region:'Temporal lobe', title:'Propaganda Exposure Index', label:'Language & interpretation', description:'Examine the messages competing to shape your perspective.', anatomy:'Contributes to hearing, memory, and language comprehension.',url:'https://propaganda-index.vercel.app/',color:'#f2bc89',d:'M356 482 L393 429 L481 371 L566 357 L641 339 L701 355 L686 413 C622 451 557 479 512 518 C459 558 408 550 394 507 Z',x:511,y:445},
 {id:'occipital',n:'04',region:'Occipital lobe',title:'The WACC',label:'A shared vision',description:'From scattered pressure to coordinated action. Explore the WACC.',anatomy:'Primarily processes visual information.',url:'https://x.com/_DrMoonhatt4n_/status/2031886765301133312',color:'#87c9ef',d:'M666 211 C724 241 758 318 771 384 C784 421 745 449 686 438 L686 413 L701 355 L641 339 L700 283 Z',x:718,y:361},
];
---
<Base>
  <div class="intro-row"><div><p class="eyebrow"><span class="status-dot"></span> The Moonhatt4n laboratory</p><h1>A mind.<br/><em>Many rabbit holes.</em></h1></div><p class="intro">Art, evidence, and systems.<br/>Explore the connections.</p></div>
  <section class="lab" aria-label="Interactive project brain map">
    <div class="lab-bar"><span>SPECIMEN / 001</span><span>LEFT HEMISPHERE · LATERAL VIEW</span></div>
    <div class="lab-body">
      <div class="specimen">
        <span class="orientation front">ANTERIOR ←</span><span class="orientation rear">→ POSTERIOR</span>
        <svg class="brain sculpture" viewBox="0 0 1000 1000" xmlns="http://www.w3.org/2000/svg" aria-label="Cyberpunk brain sculpture with four interactive project regions.">
          <image href="/brain-sculpture.png" width="1000" height="1000"/>
          {regions.map(r=><a href={r.url} class="brain-region" data-region={r.id} style={`--region:${r.color}`} aria-label={`${r.title} — ${r.region}`}><title>{r.title} · {r.region}</title><path class="hotspot" d={r.d}/><circle class="region-badge" cx={r.x} cy={r.y} r="20"/><text x={r.x} y={r.y+5}>{r.n}</text></a>)}
        </svg>
        <p class="specimen-note">Hover to investigate. Select to explore.</p>
      </div>
      <aside class="readout" aria-label="Selected project">
        {regions.map((r,i)=><div class:list={['project-detail',{active:i===0}]} data-detail={r.id}><p class="eyebrow">REGION {r.n} / {r.region}</p><p class="signal" style={`color:${r.color}`}>{r.label}</p><h2>{r.title}</h2><p>{r.description}</p><a class="open-project" href={r.url}>Explore project <span aria-hidden="true">↗</span></a><div class="anatomy"><span>ANATOMY NOTE</span><p>{r.anatomy}</p></div></div>)}
      </aside>
    </div>
    <nav class="project-list" aria-label="All brain map projects">{regions.map(r=><a href={r.url} data-region={r.id} style={`--region:${r.color}`}><span class="number">{r.n}</span><span>{r.title}<small>{r.region}</small></span><span aria-hidden="true">↗</span></a>)}</nav>
  </section>
  <div class="below"><p>An imagined specimen. Project associations are thematic; brain functions span networks. Region boundaries are approximate.</p><a href="https://linktr.ee/Dr.Moonhatt4n">More from my world ↗</a></div>
  <script>
    const targets = document.querySelectorAll<HTMLElement | SVGElement>('[data-region]');
    function select(id: string | undefined) {
      document.querySelectorAll('[data-detail]').forEach(el=>el.classList.toggle('active',el.getAttribute('data-detail')===id));
      targets.forEach(el=>el.classList.toggle('selected',el.dataset.region===id));
    }
    targets.forEach(el=>{
      el.addEventListener('pointerenter',event=>{if((event as PointerEvent).pointerType!=='touch') select(el.dataset.region);});
      el.addEventListener('focus',()=>select(el.dataset.region));
      el.addEventListener('click',event=>{
        if(el.classList.contains('brain-region') && (event as PointerEvent).pointerType==='touch') {event.preventDefault();select(el.dataset.region);}
      });
    });
    select('frontal');

    const specimen = document.querySelector<HTMLElement>('.specimen');
    const sculpture = document.querySelector<SVGElement>('.sculpture');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let frame = 0;
    let start = 0;
    let targetX = 0, targetY = 0, currentX = 0, currentY = 0;
    let hovering = false;
    function animate(time: number) {
      if (!sculpture || reducedMotion.matches) { frame = 0; return; }
      if (!start) start = time;
      currentX += (targetX - currentX) * 0.045;
      currentY += (targetY - currentY) * 0.045;
      const phase = (time - start) / 3200;
      const drift = hovering ? Math.sin(phase) * 3 : 0;
      sculpture.style.transform = `perspective(1100px) rotateX(${currentX}deg) rotateY(${currentY + drift}deg) rotateZ(${hovering ? Math.sin(phase * .7) * .7 : 0}deg)`;
      if (hovering || Math.abs(currentX) + Math.abs(currentY) > .02) {
        frame = requestAnimationFrame(animate);
      } else { sculpture.style.transform = ''; frame = 0; start = 0; }
    }
    specimen?.addEventListener('pointermove', (event) => {
      if (event.pointerType === 'touch' || reducedMotion.matches) return;
      const bounds = specimen.getBoundingClientRect();
      targetY = ((event.clientX - bounds.left) / bounds.width - .5) * 18;
      targetX = -((event.clientY - bounds.top) / bounds.height - .5) * 10;
      hovering = true;
      if (!frame) frame = requestAnimationFrame(animate);
    });
    function settle() { hovering = false; targetX = 0; targetY = 0; }
    specimen?.addEventListener('pointerleave', settle);
    window.addEventListener('blur', settle);
    reducedMotion.addEventListener('change', () => {
      settle(); cancelAnimationFrame(frame); frame = 0; start = 0;
      currentX = currentY = 0;
      if (sculpture) sculpture.style.transform = '';
    });
  </script>
</Base>
